--- a/src/quietLog.ts	1969-12-31 18:00:00
+++ b/src/quietLog.ts	2026-10-31 10:31:16
@@ -0,0 +1,27 @@
+/**
+ * quiet fork (TR #2044): one-line diagnostics for why a /pw relay connection ended. Upstream closes
+ * the whole connection silently ("All controlled tabs detached", a peer-closed websocket) and an
+ * MV3 service worker keeps no console history, so a dropped session left no trace of its cause.
+ * Each line goes to the local broker (pw/broker.mjs logs it as `ext <line>` in broker.log) and to a
+ * 100-entry ring in chrome.storage.local under 'quiet-log'.
+ */
+
+let sink: ((line: string) => void) | undefined;
+
+export function setQuietLogSink(fn: (line: string) => void): void {
+  sink = fn;
+}
+
+export function quietLog(line: string): void {
+  const entry = `${new Date().toISOString()} ${line}`;
+  try {
+    sink?.(entry);
+  } catch {
+    // diagnostics must never break the relay
+  }
+  chrome.storage.local.get('quiet-log').then(stored => {
+    const ring: string[] = Array.isArray(stored['quiet-log']) ? stored['quiet-log'] : [];
+    ring.push(entry);
+    return chrome.storage.local.set({ 'quiet-log': ring.slice(-100) });
+  }).catch(() => {});
+}
