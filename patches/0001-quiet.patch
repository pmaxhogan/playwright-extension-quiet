diff -ruN -U2 -x node_modules -x dist -x package-lock.json -x .gitignore -x manifest.json -x manifest.store.json -x package.json a/src/quietBroker.ts b/src/quietBroker.ts
--- a/src/quietBroker.ts	1969-12-31 18:00:00
+++ b/src/quietBroker.ts	2026-11-13 08:58:05
@@ -0,0 +1,148 @@
+/**
+ * quiet fork (TR #2044): keep a WebSocket to the local /pw broker and open connect pages it hands
+ * us in UNFOCUSED windows. The stock flow has the MCP exec Chrome with --new-window <connect url>,
+ * which activates Chrome and steals the user's keyboard; chrome.windows.create({focused: false})
+ * never does (measured 2026-10-30). The broker lives in pmaxhogan/claude-shortcuts pw/broker.mjs.
+ *
+ * Routing: the broker sends the token from the connect URL; we open it only if it matches the
+ * token stored for this profile (mirrored into chrome.storage.local by authToken.tsx), so a Chrome
+ * with the fork in several profiles opens the page in exactly one of them. No stored token yet
+ * (fresh profile) means we decline and the broker's caller falls back to the stock exec path, which
+ * opens the WEB STORE extension's connect page, not ours: the fork only learns its token when its
+ * own status or connect page is opened once in that profile (setup step), and the MCP config must
+ * carry the fork's token, not the Web Store extension's.
+ */
+
+import { quietLog, setQuietLogSink } from './quietLog';
+import { AgentsAppNotRunning, openAgentWindow, reportAllAgentWindows, setAgentWindowSink } from './agentsApp';
+
+const BROKER_URL = 'ws://127.0.0.1:47117/ext';
+const RECONNECT_ALARM = 'quiet-broker-reconnect';
+const DEFAULT_BOUNDS = { width: 1280, height: 900, left: 60, top: 60 };
+
+let socket: WebSocket | null = null;
+
+type OpenMessage = {
+  type: 'open';
+  id: string;
+  url: string;
+  token?: string;
+  minimized?: boolean;
+  bounds?: { width?: number; height?: number; left?: number; top?: number };
+  // Agent name: shown on an unpinned first tab (Claude Code icon) so the window is identifiable.
+  name?: string;
+  // Open the agent's window as an app window of the "Agents" PWA (own uBar item; agentsApp.ts).
+  app?: boolean;
+};
+
+// The title tab is an extension page (static/title.html, copied into dist/ by scripts/build.sh).
+// A data: page gets no favicon in Chrome (measured 2026-10-31: favIconUrl stays null); an
+// extension page does. getURL() yields whichever id is running, unpacked or Web Store. The page
+// writes ?name= with textContent only, so a hostile name cannot inject markup.
+function titleTabUrl(name: string): string {
+  return chrome.runtime.getURL('title.html') + '?name=' + encodeURIComponent(name);
+}
+
+async function storedToken(): Promise<string | undefined> {
+  const { 'auth-token': token } = await chrome.storage.local.get('auth-token');
+  return typeof token === 'string' ? token : undefined;
+}
+
+function send(message: unknown): void {
+  if (socket && socket.readyState === WebSocket.OPEN)
+    socket.send(JSON.stringify(message));
+}
+
+async function hello(): Promise<void> {
+  void reportAllAgentWindows();
+  send({ type: 'hello', extensionId: chrome.runtime.id, version: chrome.runtime.getManifest().version, token: await storedToken() });
+}
+
+async function handleOpen(message: OpenMessage): Promise<void> {
+  const token = await storedToken();
+  if (!token || (message.token && message.token !== token)) {
+    send({ type: 'declined', id: message.id, reason: token ? 'token mismatch' : 'no token stored in this profile yet' });
+    return;
+  }
+  // The MCP addresses the Web Store extension id; this fork has its own.
+  const url = new URL(message.url);
+  if (url.protocol === 'chrome-extension:')
+    url.host = chrome.runtime.id;
+  const bounds = { ...DEFAULT_BOUNDS, ...(message.bounds || {}) };
+  if (message.app) {
+    try {
+      const opened = await openAgentWindow(url.toString(), message.name, bounds);
+      send({ type: 'opened', id: message.id, ...opened, name: message.name, app: true });
+      return;
+    } catch (error: any) {
+      // Not running: the shim launches the app and asks again. Anything else: say why, and fall
+      // back to a normal window below so the agent still gets a browser.
+      if (error instanceof AgentsAppNotRunning) {
+        send({ type: 'declined', id: message.id, reason: error.message });
+        return;
+      }
+      quietLog(`agents window failed, falling back to a normal window: ${error?.message || error}`);
+    }
+  }
+  const win = await chrome.windows.create({ url: url.toString(), focused: false, type: 'normal', ...bounds });
+  if (!win)
+    throw new Error('chrome.windows.create returned no window');
+  let titleTab: string | number | undefined;
+  if (message.name && win.id !== undefined) {
+    try {
+      titleTab = (await chrome.tabs.create({ windowId: win.id, url: titleTabUrl(message.name), pinned: false, index: 0, active: false })).id;
+    } catch (error: any) {
+      titleTab = 'error: ' + (error?.message || error);
+    }
+  }
+  if (message.minimized && win.id !== undefined)
+    await chrome.windows.update(win.id, { state: 'minimized' }).catch(() => {});
+  send({ type: 'opened', id: message.id, windowId: win.id, tabId: win.tabs?.[0]?.id, titleTab, name: message.name });
+}
+
+function connect(): void {
+  if (socket && (socket.readyState === WebSocket.OPEN || socket.readyState === WebSocket.CONNECTING))
+    return;
+  try {
+    socket = new WebSocket(BROKER_URL);
+  } catch (error) {
+    quietLog(`quiet broker: cannot open socket: ${error}`);
+    return;
+  }
+  socket.onopen = () => void hello();
+  socket.onmessage = event => {
+    let message: any;
+    try {
+      message = JSON.parse(event.data);
+    } catch {
+      return;
+    }
+    if (message.type === 'ping')
+      send({ type: 'pong' });
+    else if (message.type === 'open')
+      handleOpen(message as OpenMessage).catch(error => send({ type: 'declined', id: message.id, reason: String(error?.message || error) }));
+  };
+  socket.onclose = () => {
+    socket = null;
+  };
+  socket.onerror = () => {};
+}
+
+export function startQuietBroker(): void {
+  // Relay close / detach reasons (quietLog.ts) go to the broker's log as `ext <line>`.
+  setQuietLogSink(line => send({ type: 'log', line }));
+  setAgentWindowSink(message => send(message));
+  connect();
+  // The broker may not be running yet (it starts with the first /pw connect); keep trying. The
+  // alarm also wakes the service worker if Chrome put it to sleep.
+  chrome.alarms.create(RECONNECT_ALARM, { periodInMinutes: 0.5 });
+  chrome.alarms.onAlarm.addListener(alarm => {
+    if (alarm.name === RECONNECT_ALARM)
+      connect();
+  });
+  chrome.runtime.onStartup.addListener(connect);
+  chrome.storage.onChanged.addListener((changes, area) => {
+    if (area === 'local' && changes['auth-token'])
+      void hello();
+  });
+}
